{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Creators-of-Aeronautics/Simulated-Project"
  },
  "license": "MIT (code), All Rights Reserved (assets)",
  "icon": "simulated.png",
  "environment": "*",
  "accessWidener": "simulated.accesswidener",
  "entrypoints": {
    "main": [
      "dev.simulated_team.simulated.fabric.SimulatedFabric"
    ],
    "client": [
      "dev.simulated_team.simulated.fabric.SimulatedFabricClient"
    ],
    "jei_mod_plugin": [
      "dev.simulated_team.simulated.compat.jei.SimulatedJEI"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "create": ">=6.0.9",
    "sable": "*",
    "forgeconfigapiport": "*"
  }
}
