{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Creators-of-Aeronautics/Simulated-Project"
  },
  "license": "MIT (code), All Rights Reserved (assets)",
  "icon": "aeronautics.png",
  "environment": "*",
  "accessWidener": "aeronautics.accesswidener",
  "entrypoints": {
    "main": [
      "dev.eriksonn.aeronautics.fabric.AeronauticsFabric"
    ],
    "client": [
      "dev.eriksonn.aeronautics.fabric.AeronauticsFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "create": ">=6.0.9-",
    "sable": "*",
    "simulated": "*",
    "forgeconfigapiport": "*"
  }
}
